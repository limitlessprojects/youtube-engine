# Secrets — NEVER commit
.secrets/
token.json
client_secret.json
*.pem
*.key
.env
.env.*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Remotion builds
node_modules/
out/
dist/
.remotion/

# Render outputs (big binaries stay out of git)
output/
work/
*.mp4
*.mov
*.webm
!research/**/*.mp4

# OS noise
.DS_Store
Thumbs.db

# Scratch
*.log
.queue/

# Raw competitor transcripts stay local-only once public (copyright hygiene);
# blueprints (derived metrics) remain tracked.
research/transcripts/*.json
research/transcripts/*.txt
research/proxies/
content/*/render/frames/
content/*/render/scenes.built.html
content/*/gate/*
content/*/*.mp4
!content/*/gate/report.json
!content/*/gate/ultracritic_r*.json
!content/*/gate/notes.json
!content/*/gate/day_night_probe.json
content/*/vo/*.wav
content/*/vo/master.m4a

# Carry/debt reports are DOCS, not gate artifacts (L-083: named claims must be tracked)
!content/*/gate/carry_*.md
research/cache/
